{
  "schema": "lilypatch.text.v1",
  "target_id": "th14_100b",
  "resource": "data/st02e.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "こんな人里の近くにも",
        "暴れる妖怪が……"
      ],
      "translated_lines": [
        "离人类村庄这么近的地方",
        "也有大闹的妖怪……"
      ]
    },
    "text-001": {
      "original_lines": [
        "幻想郷の平和なんて",
        "砂上のバベルみたいなもんね"
      ],
      "translated_lines": [
        "幻想乡的和平",
        "也就像是沙上的巴别塔吧"
      ]
    },
    "text-002": {
      "original_lines": [
        "早速現れたわね"
      ],
      "translated_lines": [
        "这么快就出现了呢"
      ]
    },
    "text-003": {
      "original_lines": [
        "私を退治しに来たというの？"
      ],
      "translated_lines": [
        "是来退治我的吗？"
      ]
    },
    "text-004": {
      "original_lines": [
        "ええ　まあ"
      ],
      "translated_lines": [
        "是啊，差不多"
      ]
    },
    "text-005": {
      "original_lines": [
        "何か斬ってみたくなりまして",
        "首とか……"
      ],
      "translated_lines": [
        "突然想砍点什么东西",
        "比如头之类的……"
      ]
    },
    "text-006": {
      "original_lines": [
        "勇敢な人間もいたもんね"
      ],
      "translated_lines": [
        "原来也有勇敢的人类啊"
      ]
    },
    "text-007": {
      "original_lines": [
        "その見返りは",
        "恐怖体験だけどな！"
      ],
      "translated_lines": [
        "不过相应地会得到的",
        "只有恐怖体验而已！"
      ]
    },
    "text-008": {
      "original_lines": [
        "な　なによあんた",
        "強いじゃないのよ"
      ],
      "translated_lines": [
        "你，你是什么人",
        "这不是很强吗"
      ]
    },
    "text-009": {
      "original_lines": [
        "弱いだなんて一度でも",
        "言いました？"
      ],
      "translated_lines": [
        "我什么时候说过",
        "我弱了？"
      ]
    },
    "text-010": {
      "original_lines": [
        "しかし……当てが外れたわ"
      ],
      "translated_lines": [
        "不过……真是失望"
      ]
    },
    "text-011": {
      "original_lines": [
        "な　なんの？"
      ],
      "translated_lines": [
        "为，为什么？"
      ]
    },
    "text-012": {
      "original_lines": [
        "斬る必要が無かったから……",
        "あなたの首"
      ],
      "translated_lines": [
        "因为没有砍掉的必要啊……",
        "你的头"
      ]
    },
    "text-013": {
      "original_lines": [
        "ぎゃー！"
      ],
      "translated_lines": [
        "呀啊啊！"
      ]
    }
  }
}
