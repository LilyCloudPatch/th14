{
  "schema": "lilypatch.text.v1",
  "target_id": "th14_100b",
  "resource": "data/st01e.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "こんなものですかね",
        "湖掃除"
      ],
      "translated_lines": [
        "清理湖面",
        "应该就是这样子吧"
      ]
    },
    "text-001": {
      "original_lines": [
        "あなたは！"
      ],
      "translated_lines": [
        "你是！"
      ]
    },
    "text-002": {
      "original_lines": [
        "畔のお屋敷にいる……"
      ],
      "translated_lines": [
        "在湖畔的宅邸里的……"
      ]
    },
    "text-003": {
      "original_lines": [
        "半漁人！？"
      ],
      "translated_lines": [
        "半鱼人！？"
      ]
    },
    "text-004": {
      "original_lines": [
        "この死の湖に妖精以外の",
        "生き物が居たなんて……"
      ],
      "translated_lines": [
        "在这个死之湖",
        "居然还有妖精以外的生物……"
      ]
    },
    "text-005": {
      "original_lines": [
        "ほらほらそんな感じ",
        "なんだもん"
      ],
      "translated_lines": [
        "对对就是那种",
        "感觉"
      ]
    },
    "text-006": {
      "original_lines": [
        "|-2,8,ようかい",
        "私達の存在を忘れて",
        "久しいんだわ！"
      ],
      "translated_lines": [
        "|2,16,妖怪",
        "我们的存在已经被遗忘",
        "很久了！"
      ]
    },
    "text-007": {
      "original_lines": [
        "身近にも色んな",
        "生き物が居たんですね"
      ],
      "translated_lines": [
        "在身边原来也有这样",
        "形形色色的生物啊"
      ]
    },
    "text-008": {
      "original_lines": [
        "うーん面白い",
        "ちょっと見回りして"
      ],
      "translated_lines": [
        "嗯～真是有趣",
        "再稍微转一转"
      ]
    },
    "text-009": {
      "original_lines": [
        "このナイフの錆びにして",
        "あげましょう"
      ],
      "translated_lines": [
        "把它们都弄成",
        "这把刀上的锈迹吧"
      ]
    }
  }
}
