{
  "schema": "lilypatch.text.v1",
  "target_id": "th14_100b",
  "resource": "data/st07a.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "さっきの楽器の付喪神が",
        "絡んでいるとすると"
      ],
      "translated_lines": [
        "既然和刚刚那乐器的付丧神",
        "有关系"
      ]
    },
    "text-001": {
      "original_lines": [
        "やっぱり付喪神なのかな？",
        "楽器なのかな？"
      ],
      "translated_lines": [
        "果然还是付丧神吧？",
        "是乐器吧？"
      ]
    },
    "text-002": {
      "original_lines": [
        "ようやく来たわね",
        "博麗神社の巫女よ"
      ],
      "translated_lines": [
        "终于来了呢",
        "博丽神社的巫女啊"
      ]
    },
    "text-003": {
      "original_lines": [
        "今頃来ても",
        "もう遅いけどね"
      ],
      "translated_lines": [
        "虽然现在才来",
        "已经太迟了"
      ]
    },
    "text-004": {
      "original_lines": [
        "やっぱり楽器の付喪神ねー",
        "ようやく勘を取り戻せてきたわ"
      ],
      "translated_lines": [
        "果然也是乐器的付丧神呢～",
        "我的直觉终于回来了"
      ]
    },
    "text-005": {
      "original_lines": [
        "でも残念ね"
      ],
      "translated_lines": [
        "但是很遗憾呢"
      ]
    },
    "text-006": {
      "original_lines": [
        "打ち出の小槌は回収期に入ったから",
        "あんたもすぐに普通の道具に戻るわよ"
      ],
      "translated_lines": [
        "万宝槌的魔力已经进入回收期",
        "你也就要变回普通的道具了哟"
      ]
    },
    "text-007": {
      "original_lines": [
        "あら巫女ともあろう者が",
        "なんて勘の鈍い事を……"
      ],
      "translated_lines": [
        "哎呀这位被称之为巫女的人啊",
        "怎么说些这么迟钝的话……"
      ]
    },
    "text-008": {
      "original_lines": [
        "もう小槌の魔力を失っても",
        "ただの道具には戻らないわ"
      ],
      "translated_lines": [
        "即使万宝槌的魔力消失",
        "我也不会变回单纯的道具了"
      ]
    },
    "text-009": {
      "original_lines": [
        "え？"
      ],
      "translated_lines": [
        "咦？"
      ]
    },
    "text-010": {
      "original_lines": [
        "打ち出の小槌の魔力が力の源だと",
        "私はすぐに気が付いたの"
      ],
      "translated_lines": [
        "万宝槌的魔力是力量之源",
        "这我早就已经发现了"
      ]
    },
    "text-011": {
      "original_lines": [
        "そのまま享受していては",
        "真の自立とは言えない"
      ],
      "translated_lines": [
        "但就这样单纯享受着",
        "不能说是真正的自立"
      ]
    },
    "text-012": {
      "original_lines": [
        "だから考えた"
      ],
      "translated_lines": [
        "所以我想到了"
      ]
    },
    "text-013": {
      "original_lines": [
        "打ち出の小槌の魔力を捨て",
        "別の魔力を取り込む呪法……"
      ],
      "translated_lines": [
        "舍弃万宝槌的魔力",
        "获取其他魔力的咒法……"
      ]
    },
    "text-014": {
      "original_lines": [
        "それを教えたのよ",
        "付喪神のみんなに"
      ],
      "translated_lines": [
        "我已经将这些",
        "教给了其他的付丧神"
      ]
    },
    "text-015": {
      "original_lines": [
        "別の魔力を取り込む呪法だって？",
        "たかが道具にそんな知恵が……"
      ],
      "translated_lines": [
        "获取其他魔力的咒法？",
        "道具怎么会有这种智慧……"
      ]
    },
    "text-016": {
      "original_lines": [
        "あらあら",
        "道具の方がよく知っててよ"
      ],
      "translated_lines": [
        "哎呀哎呀",
        "道具自己可是知道的哟"
      ]
    },
    "text-017": {
      "original_lines": [
        "何故なら道具は全て使用者の魔力で",
        "動いているんだからね"
      ],
      "translated_lines": [
        "因为道具是全凭使用者的魔力",
        "活动的呢"
      ]
    },
    "text-018": {
      "original_lines": [
        "さあ試すとするか",
        "私の新しい魔力を"
      ],
      "translated_lines": [
        "那就来试试吧",
        "我全新的魔力"
      ]
    },
    "text-019": {
      "original_lines": [
        "|113,11,ドラマー",
        "さあ外の世界の使役者よ！",
        "幻想郷に始原のビートを響かせよ！"
      ],
      "translated_lines": [
        "|136,17,鼓手",
        "来吧，外面世界的使用者啊！",
        "在此幻想乡敲响那原初的节拍吧！"
      ]
    },
    "text-020": {
      "original_lines": [
        "あらららら",
        "降参よー"
      ],
      "translated_lines": [
        "哎呀呀呀呀",
        "我投降～"
      ]
    },
    "text-021": {
      "original_lines": [
        "道具の割には中々やるじゃない"
      ],
      "translated_lines": [
        "身为道具你还算挺能干的嘛"
      ]
    },
    "text-022": {
      "original_lines": [
        "でも一人前の妖怪までは",
        "まだまだね"
      ],
      "translated_lines": [
        "但是距离能够独当一面的妖怪",
        "还差得远呢"
      ]
    },
    "text-023": {
      "original_lines": [
        "外の世界の魔力だけでは",
        "敵わないのか……"
      ],
      "translated_lines": [
        "单靠外面世界的魔力",
        "还是无法匹敌么……"
      ]
    },
    "text-024": {
      "original_lines": [
        "でもまあいいや",
        "十分戦えることが判ったし"
      ],
      "translated_lines": [
        "不过算了",
        "也已经算是很能打了"
      ]
    },
    "text-025": {
      "original_lines": [
        "それにしても別の魔力を",
        "取り込む呪法……かぁ"
      ],
      "translated_lines": [
        "尽管如此获取其他魔力的",
        "咒法……吗"
      ]
    },
    "text-026": {
      "original_lines": [
        "付喪神がそんな悪知恵を",
        "働かせるなんて思わなかったわ"
      ],
      "translated_lines": [
        "没想到付丧神",
        "也会动那种坏脑筋呢"
      ]
    },
    "text-027": {
      "original_lines": [
        "誰だって自分が生き残るのには",
        "努力を惜しまないでしょ？"
      ],
      "translated_lines": [
        "无论是谁都会不惜一切代价",
        "努力让自己生存下去吧？"
      ]
    },
    "text-028": {
      "original_lines": [
        "それは悪知恵でも何でもないわ"
      ],
      "translated_lines": [
        "那可不是什么坏脑筋"
      ]
    },
    "text-029": {
      "original_lines": [
        "ところでどういう物なの？",
        "その呪法"
      ],
      "translated_lines": [
        "话说那是什么东西？",
        "那个咒法"
      ]
    },
    "text-030": {
      "original_lines": [
        "小槌の魔力の様に勝手に",
        "入り込むのは例外だけど……"
      ],
      "translated_lines": [
        "和万宝槌的魔力那样",
        "随意获取的方式不同……"
      ]
    },
    "text-031": {
      "original_lines": [
        "本来　道具の魔力は使用者の魔力なの",
        "使ってくれる人で魔力が変わる"
      ],
      "translated_lines": [
        "原本，道具的魔力就是使用者的魔力",
        "根据使用的人魔力会相应变化"
      ]
    },
    "text-032": {
      "original_lines": [
        "だから私は外の世界から流れてきた",
        "太鼓を取り込んだのよ"
      ],
      "translated_lines": [
        "所以我吸纳了从外界",
        "流进来的太鼓"
      ]
    },
    "text-033": {
      "original_lines": [
        "|116,14,ドラマー",
        "外の世界にいる魔法使いの魔力が",
        "私の心を満たす　それが呪法よ"
      ],
      "translated_lines": [
        "|87,17,鼓手",
        "位于外界的魔法使的魔力",
        "满足我的内心，这就是咒法"
      ]
    },
    "text-034": {
      "original_lines": [
        "ふーん",
        "よく判らないけど何か便利そうね"
      ],
      "translated_lines": [
        "是吗",
        "虽然不太懂但似乎很方便呢"
      ]
    },
    "text-035": {
      "original_lines": [
        "何にしても大人しくしていれば",
        "私は……道具には攻撃しない事にしたわ"
      ],
      "translated_lines": [
        "不管如何只要老老实实的话",
        "我……不会再攻击道具的"
      ]
    },
    "text-036": {
      "original_lines": [
        "あら有難うございます",
        "|32,10,あなた",
        "私も巫女には逆らいません"
      ],
      "translated_lines": [
        "那真是万分感谢了",
        "|110,10,你",
        "我也不会违抗巫女的"
      ]
    },
    "text-037": {
      "original_lines": [
        "他の妖怪がどう動くかまでは",
        "約束できないけどね"
      ],
      "translated_lines": [
        "但是其他妖怪会如何行动",
        "我就无法保证了"
      ]
    },
    "text-038": {
      "original_lines": [
        "悪いけどここで足止めさせてもらうよ"
      ],
      "translated_lines": [
        "虽然不好意思，但我们要在这里阻止你"
      ]
    },
    "text-039": {
      "original_lines": [
        "鎮魂ライブの始まり始まりー！"
      ],
      "translated_lines": [
        "镇魂演出就此开演就此开演～！"
      ]
    }
  }
}
