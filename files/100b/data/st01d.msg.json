{
  "schema": "lilypatch.text.v1",
  "target_id": "th14_100b",
  "resource": "data/st01d.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "ちょっと肌寒いな"
      ],
      "translated_lines": [
        "有点冷啊"
      ]
    },
    "text-001": {
      "original_lines": [
        "あなたは！"
      ],
      "translated_lines": [
        "你是！"
      ]
    },
    "text-002": {
      "original_lines": [
        "私を退治しに来たのですね？"
      ],
      "translated_lines": [
        "来退治我的吧？"
      ]
    },
    "text-003": {
      "original_lines": [
        "ん？",
        "ああ　まあそうかな"
      ],
      "translated_lines": [
        "嗯？",
        "啊啊，差不多吧"
      ]
    },
    "text-004": {
      "original_lines": [
        "それにしても人魚か",
        "湖にいたんだな"
      ],
      "translated_lines": [
        "不过是人鱼啊",
        "原来湖里也有啊"
      ]
    },
    "text-005": {
      "original_lines": [
        "いつも無視するんだもん"
      ],
      "translated_lines": [
        "总是无视我啊"
      ]
    },
    "text-006": {
      "original_lines": [
        "|62,8,ようかい",
        "そろそろ私達の出番が",
        "あってもいいでしょ？"
      ],
      "translated_lines": [
        "也应该有",
        "|2,16,妖怪",
        "我们的出场机会了吧？"
      ]
    },
    "text-007": {
      "original_lines": [
        "ああ所詮は半分魚だ",
        "大したことは無かったな"
      ],
      "translated_lines": [
        "啊啊毕竟有一半是鱼",
        "没成什么大气候"
      ]
    },
    "text-008": {
      "original_lines": [
        "全部魚にした方が",
        "強かったんじゃないか？"
      ],
      "translated_lines": [
        "如果全身都是鱼",
        "会不会更强一些？"
      ]
    }
  }
}
