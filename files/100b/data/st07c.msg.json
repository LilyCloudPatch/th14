{
  "schema": "lilypatch.text.v1",
  "target_id": "th14_100b",
  "resource": "data/st07c.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "いやー",
        "やっと魔力が抜け始めてきたけど"
      ],
      "translated_lines": [
        "哎呀～",
        "魔力总算开始消退了"
      ]
    },
    "text-001": {
      "original_lines": [
        "今回は参ったぜ　まさか私が",
        "ミニ八卦炉に影響を受けてたとはな"
      ],
      "translated_lines": [
        "这次真是被摆了一道，没想到我",
        "竟然会被迷你八卦炉所左右"
      ]
    },
    "text-002": {
      "original_lines": [
        "ようやく来たわね",
        "魔法使いの人間よ"
      ],
      "translated_lines": [
        "终于来了呢",
        "人类魔法使哟"
      ]
    },
    "text-003": {
      "original_lines": [
        "私を封じに来たというのなら",
        "もう手遅れよ"
      ],
      "translated_lines": [
        "如果你是来封印我的",
        "你已经来迟了"
      ]
    },
    "text-004": {
      "original_lines": [
        "手遅れだと？"
      ],
      "translated_lines": [
        "迟了？"
      ]
    },
    "text-005": {
      "original_lines": [
        "私は自立した魔力を",
        "手に入れたのよ"
      ],
      "translated_lines": [
        "我已经得到了",
        "独立的魔力"
      ]
    },
    "text-006": {
      "original_lines": [
        "もう打ち出の小槌の魔力など",
        "必要ない"
      ],
      "translated_lines": [
        "已经不再需要",
        "万宝槌的魔力了"
      ]
    },
    "text-007": {
      "original_lines": [
        "なんだって？",
        "確かに……"
      ],
      "translated_lines": [
        "你说什么？",
        "确实……"
      ]
    },
    "text-008": {
      "original_lines": [
        "お前から感じる魔力は",
        "ミニ八卦炉のそれとは異なるな"
      ],
      "translated_lines": [
        "从你身上感觉到的魔力",
        "和迷你八卦炉的是不太一样"
      ]
    },
    "text-009": {
      "original_lines": [
        "魔力を取り替えたのよ",
        "呪われた小槌の魔力を抜いてね"
      ],
      "translated_lines": [
        "我替换了魔力啊",
        "被诅咒的小槌的魔力已经没有了"
      ]
    },
    "text-010": {
      "original_lines": [
        "取り替えた……だと？",
        "付喪神風情にそんな高度な術が……"
      ],
      "translated_lines": [
        "你说……替换？",
        "区区付丧神竟会这种高难度法术……"
      ]
    },
    "text-011": {
      "original_lines": [
        "あらあら",
        "付喪神だから簡単に出来るのよ？"
      ],
      "translated_lines": [
        "哎呀哎呀",
        "正因为是付丧神才不难做到哦？"
      ]
    },
    "text-012": {
      "original_lines": [
        "何故なら道具は使用者を変えれば",
        "魔力が変わるんだからね"
      ],
      "translated_lines": [
        "因为道具只要使用者一变",
        "魔力也会随之变化"
      ]
    },
    "text-013": {
      "original_lines": [
        "さあ試すとするか",
        "私の新しい魔力を"
      ],
      "translated_lines": [
        "那就来试试吧",
        "我全新的魔力"
      ]
    },
    "text-014": {
      "original_lines": [
        "|113,11,ドラマー",
        "さあ外の世界の使役者よ！",
        "空前絶後のビートを響かせよ！"
      ],
      "translated_lines": [
        "|136,17,鼓手",
        "来吧，外面世界的使用者啊！",
        "打响空前绝后的节拍吧！"
      ]
    },
    "text-015": {
      "original_lines": [
        "あらららら",
        "降参よー"
      ],
      "translated_lines": [
        "哎呀呀呀呀",
        "我投降～"
      ]
    },
    "text-016": {
      "original_lines": [
        "ふっ　やるじゃないか",
        "恐ろしい魔力だったぜ"
      ],
      "translated_lines": [
        "呼，挺厉害嘛",
        "真是可怕的魔力"
      ]
    },
    "text-017": {
      "original_lines": [
        "しかし何だ",
        "その魔力は……外の世界の魔力か"
      ],
      "translated_lines": [
        "不过话说",
        "这份魔力……是外面世界的魔力吗"
      ]
    },
    "text-018": {
      "original_lines": [
        "外の世界には優れた太鼓叩きが",
        "多いのよ"
      ],
      "translated_lines": [
        "外面世界太鼓打得好的人",
        "大有人在哦"
      ]
    },
    "text-019": {
      "original_lines": [
        "そういう道具使いを太鼓の達人",
        "って呼ぶくらい"
      ],
      "translated_lines": [
        "那样的道具使貌似被称作",
        "太鼓达人"
      ]
    },
    "text-020": {
      "original_lines": [
        "ほう　外の世界には色んな魔法が",
        "あるんだろうなぁ"
      ],
      "translated_lines": [
        "喔，外面的世界也有",
        "各种各样的魔法啊"
      ]
    },
    "text-021": {
      "original_lines": [
        "何にしても気に入ったぜ",
        "お前のビート"
      ],
      "translated_lines": [
        "无论如何你的鼓点",
        "搞得我也有点兴趣了"
      ]
    },
    "text-022": {
      "original_lines": [
        "人間に危害を与えないと約束すれば",
        "ここで退治するのは止めてやる"
      ],
      "translated_lines": [
        "你如果保证不去危害人类",
        "我的退治就到此为止"
      ]
    },
    "text-023": {
      "original_lines": [
        "ほんと？",
        "するする　約束しますー"
      ],
      "translated_lines": [
        "真的？",
        "好啊好啊，我向你保证～"
      ]
    },
    "text-024": {
      "original_lines": [
        "……軽いな"
      ],
      "translated_lines": [
        "……这么随便"
      ]
    },
    "text-025": {
      "original_lines": [
        "だって……ただの道具には",
        "戻りたくないしー"
      ],
      "translated_lines": [
        "因为……我可不想再变回",
        "单纯的道具嘛～"
      ]
    },
    "text-026": {
      "original_lines": [
        "それに自分で動ければ良いだけで",
        "暴れるのは本来の目的では無いしね"
      ],
      "translated_lines": [
        "而且我只要能凭自己意志行动就好",
        "没打算胡闹的"
      ]
    },
    "text-027": {
      "original_lines": [
        "自分で動ければ良い……か"
      ],
      "translated_lines": [
        "凭自己意志行动就好……吗"
      ]
    },
    "text-028": {
      "original_lines": [
        "私のミニ八卦炉ももしかして",
        "そう思っているのか？"
      ],
      "translated_lines": [
        "我的迷你八卦炉会不会",
        "也是这么想的呢？"
      ]
    },
    "text-029": {
      "original_lines": [
        "危ない危ない",
        "さっさと魔力を抜いちまおう"
      ],
      "translated_lines": [
        "不好不好",
        "得赶紧去除掉这魔力"
      ]
    },
    "text-030": {
      "original_lines": [
        "悪いけどここで足止めさせてもらうよ"
      ],
      "translated_lines": [
        "虽然不好意思，但我们要在这里阻止你"
      ]
    },
    "text-031": {
      "original_lines": [
        "鎮魂ライブの始まり始まりー！"
      ],
      "translated_lines": [
        "镇魂演出就此开演就此开演～！"
      ]
    }
  }
}
